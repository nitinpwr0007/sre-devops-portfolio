terraform {
  required_version = ">= 1.6"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

# Bootstrap talks to LocalStack with throwaway creds and every endpoint pointed
# at the local gateway. skip_* flags stop the provider trying to reach the real
# AWS metadata/STS endpoints.
provider "aws" {
  region                      = "us-east-1"
  access_key                  = "test"
  secret_key                  = "test"
  s3_use_path_style           = true
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_requesting_account_id  = true

  endpoints {
    s3       = "http://localhost:14566"
    dynamodb = "http://localhost:14566"
  }
}
