{
  "uid": "week2-red",
  "title": "Week2 — RED (week2-app)",
  "tags": ["week2", "red"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "text",
      "title": "RED = Rate · Errors · Duration (request-centric — the view for a service)",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**RED** answers *is this service healthy?* — **Rate** (traffic), **Errors** (failed requests), **Duration** (latency). All from `http_requests_total` and `http_request_duration_seconds` in Mimir."
      }
    },
    {
      "type": "timeseries",
      "title": "Rate — requests/sec by endpoint",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (endpoint) (rate(http_requests_total{job=\"week2-app\"}[1m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Errors — 5xx ratio (last 5m)",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.05 }
          ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(http_requests_total{job=\"week2-app\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"week2-app\"}[5m])), 0.0001)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors — 5xx req/sec by endpoint",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 3 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (endpoint) (rate(http_requests_total{job=\"week2-app\",status=~\"5..\"}[5m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duration — p50 / p95 / p99 (exemplars on)",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 11 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "targets": [
        {
          "refId": "p50",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"week2-app\"}[5m])))",
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "refId": "p95",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"week2-app\"}[5m])))",
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "refId": "p99",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"week2-app\"}[5m])))",
          "legendFormat": "p99",
          "exemplar": true
        }
      ]
    }
  ]
}
